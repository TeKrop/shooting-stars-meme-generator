{
	"name": "shooting-stars",
	"version": "2.11.1",
	"description": "Shooting Stars Meme Generator",
	"main": "server/server.ts",
	"scripts": {
		"test": "bun test",
		"start": "bun server/server.ts",
		"dev": "bun --hot server/server.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"generate:css": "bun scripts/generate-stars-css.ts",
		"verify:css": "bun scripts/generate-stars-css.ts --check",
		"check": "bun run typecheck && bun run lint && bun run verify:css"
	},
	"keywords": [
		"shooting",
		"stars",
		"meme",
		"generator"
	],
	"author": "Valentin PORCHET",
	"license": "MIT",
	"dependencies": {
		"@napi-rs/canvas": "^1.0.9",
		"cropperjs": "^2.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
